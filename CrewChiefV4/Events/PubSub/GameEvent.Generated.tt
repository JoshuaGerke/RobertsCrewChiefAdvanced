<#@ template language="C#" hostspecific="true" debug="false" #>
<#@ assembly name="System.Core" #>
<#@ assembly name="System.IO.Compression" #>
<#@ assembly name="System.IO.Compression.FileSystem" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ assembly name="System.Xml" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.IO.Compression" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Xml.Linq" #>
<#
    // Place this .tt beside GameStateEvents.xlsx. Run "Transform All T4 Templates".
    string folder = Path.GetDirectoryName(Host.TemplateFile);
    string workbook = Path.Combine(folder, "GameStateEvents.xlsx");
    List<EventRow> events = ReadEvents(workbook);
    WriteIfChanged(Path.Combine(folder, "GameStateEvents.csv"), MakeCsv(events));
    WriteIfChanged(Path.Combine(folder, "GameEvent.Generated.cs"), MakeEnum(events));
    WriteIfChanged(Path.Combine(folder, "GameEventBool.Generated.cs"), MakeBools(events));
    WriteIfChanged(Path.Combine(folder, "GameStateEventDetector.Generated.cs"), MakeDetector(events));
    UpdateCustom(Path.Combine(folder, "GameStateEventDetector.Custom.cs"), events);
#><#+
    const string NamespaceName = "CrewChiefV4.Events.PubSub";
    const string Marker = "        // <NEW CUSTOM DETECTORS - generator inserts above this line>";
    const string Header = "// <auto-generated> From GameStateEvents.xlsx. Do not edit. </auto-generated>";
    const string CustomComment =
        "        // The boilerplate for this is provided by the generator, implement the\n" +
        "        // detection logic to replace the #error.";

    class EventRow
    {
        public string Name, Property, Condition;
        public EventRow(string name, string property, string condition)
        {
            Name = name; Property = property; Condition = condition;
        }
    }

    static string LF(string s) { return s.Replace("\r\n", "\n").Replace("\r", "\n"); }

    static void WriteIfChanged(string path, string contents)
    {
        contents = LF(contents);
        if (!File.Exists(path) || LF(File.ReadAllText(path)) != contents)
            File.WriteAllText(path, contents, new UTF8Encoding(false));
    }

    static string CellText(XElement cell, XNamespace ns, List<string> shared)
    {
        if (cell == null) return "";
        string type = (string)cell.Attribute("t");
        if (type == "inlineStr")
            return string.Concat(cell.Descendants(ns + "t").Select(x => (string)x));
        string raw = (string)cell.Element(ns + "v") ?? "";
        if (type == "s")
        {
            int index;
            if (!int.TryParse(raw, out index) || index < 0 || index >= shared.Count)
                throw new InvalidDataException("Invalid shared string index: " + raw);
            return shared[index];
        }
        return raw;
    }

    static List<EventRow> ReadEvents(string path)
    {
        if (!File.Exists(path)) throw new FileNotFoundException("Workbook not found", path);
        XNamespace ns = "http://schemas.openxmlformats.org/spreadsheetml/2006/main";
        using (var zip = ZipFile.OpenRead(path))
        {
            var shared = new List<string>();
            var sharedEntry = zip.GetEntry("xl/sharedStrings.xml");
            if (sharedEntry != null)
            {
                using (var stream = sharedEntry.Open())
                {
                    var xml = XDocument.Load(stream);
                    shared = xml.Descendants(ns + "si")
                        .Select(si => string.Concat(si.Descendants(ns + "t").Select(t => (string)t)))
                        .ToList();
                }
            }

            // The source workbook uses its first worksheet (sheet1.xml).
            var sheetEntry = zip.GetEntry("xl/worksheets/sheet1.xml");
            if (sheetEntry == null)
                throw new InvalidDataException("Expected first worksheet at xl/worksheets/sheet1.xml");
            XDocument sheet;
            using (var stream = sheetEntry.Open()) sheet = XDocument.Load(stream);
            var rows = sheet.Descendants(ns + "sheetData").Elements(ns + "row").ToList();
            if (rows.Count == 0) throw new InvalidDataException("Workbook has no rows");

            Func<XElement, string[]> columns = row =>
            {
                var values = new string[3];
                foreach (var cell in row.Elements(ns + "c"))
                {
                    string reference = (string)cell.Attribute("r") ?? "";
                    var match = Regex.Match(reference, @"^[A-Z]+");
                    if (!match.Success) continue;
                    int column = 0;
                    foreach (char ch in match.Value) column = column * 26 + (ch - 'A' + 1);
                    if (column >= 1 && column <= 3)
                        values[column - 1] = CellText(cell, ns, shared).Trim();
                }
                return values.Select(x => x ?? "").ToArray();
            };

            var header = columns(rows[0]);
            if (!header[0].Equals("Event", StringComparison.OrdinalIgnoreCase) ||
                !header[1].Equals("GameState Property", StringComparison.OrdinalIgnoreCase) ||
                !header[2].Equals("Condition", StringComparison.OrdinalIgnoreCase))
                throw new InvalidDataException("First row must be: Event, GameState Property, Condition");

            var events = new List<EventRow>();
            var seen = new HashSet<string>(StringComparer.Ordinal);
            var operators = new HashSet<string> { "becomesTrue", "becomesFalse", "changes", "isSet", "increases" };
            foreach (var row in rows.Skip(1))
            {
                var cells = columns(row);
                string name = cells[0], prop = cells[1], op = cells[2];
                if (cells.All(string.IsNullOrEmpty)) continue;
                string rowNumber = (string)row.Attribute("r") ?? "?";
                if (!Regex.IsMatch(name, @"^[A-Za-z_][A-Za-z_0-9]*$"))
                    throw new InvalidDataException("Invalid event name on row " + rowNumber);
                if (!seen.Add(name))
                    throw new InvalidDataException("Duplicate event " + name);
                if (string.IsNullOrEmpty(prop) != string.IsNullOrEmpty(op))
                    throw new InvalidDataException("Property and condition must both be present or blank on row " + rowNumber);
                if (prop.Length > 0 &&
                    (!Regex.IsMatch(prop, @"^[A-Za-z_][A-Za-z_0-9]*(\.[A-Za-z_][A-Za-z_0-9]*)*$") ||
                     !operators.Contains(op)))
                    throw new InvalidDataException("Invalid property or condition on row " + rowNumber);
                events.Add(new EventRow(name, prop, op));
            }
            if (events.Count == 0) throw new InvalidDataException("No events found");
            return events.OrderBy(e => e.Name, StringComparer.Ordinal).ToList();
        }
    }

    static string CsvField(string value)
    {
        return value.IndexOfAny(new[] { ',', '"', '\n' }) < 0
            ? value : "\"" + value.Replace("\"", "\"\"") + "\"";
    }

    static string MakeCsv(List<EventRow> events)
    {
        var sb = new StringBuilder("Event,GameState Property,Condition\n");
        foreach (var e in events)
            sb.AppendLine(string.Join(",", new[] { e.Name, e.Property, e.Condition }.Select(CsvField)));
        return LF(sb.ToString());
    }

    static string MakeEnum(List<EventRow> events)
    {
        var sb = new StringBuilder();
        sb.AppendLine(Header);
        sb.AppendLine("namespace " + NamespaceName);
        sb.AppendLine("{");
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// Generic game events that are published to subscribed handlers");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    public enum GameEvent");
        sb.AppendLine("    {");
        foreach (var e in events) sb.AppendLine("        " + e.Name + ",");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return LF(sb.ToString());
    }

    static string MakeBools(List<EventRow> events)
    {
        var sb = new StringBuilder();
        sb.AppendLine(Header);
        sb.AppendLine("namespace " + NamespaceName);
        sb.AppendLine("{");
        sb.AppendLine("    /// <summary>");
        sb.AppendLine("    /// One for each game event that is detected, contains the current ");
        sb.AppendLine("    /// state of the event as detected in the current tick");
        sb.AppendLine("    /// </summary>");
        sb.AppendLine("    public static class GameEventBool");
        sb.AppendLine("    {");
        foreach (var e in events)
            sb.AppendLine("        public static bool " + e.Name + " { get; internal set; }");
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return LF(sb.ToString());
    }

    static string Expression(EventRow e)
    {
        string p = "pgs." + e.Property, c = "cgs." + e.Property;
        switch (e.Condition)
        {
            case "becomesTrue": return "!" + p + " && " + c;
            case "becomesFalse": return p + " && !" + c;
            case "changes": return p + " != " + c;
            case "increases": return c + " > " + p;
            case "isSet": return c;
            default: throw new InvalidDataException("Unknown operator " + e.Condition);
        }
    }

    static string MakeDetector(List<EventRow> events)
    {
        var sb = new StringBuilder();
        sb.AppendLine(Header);
        sb.AppendLine("using CrewChiefV4.GameState;");
        sb.AppendLine("namespace " + NamespaceName);
        sb.AppendLine("{");
        sb.AppendLine("    public partial class GameStateEventDetector");
        sb.AppendLine("    {");
        sb.AppendLine("        private void DetectEvents(GameStateData pgs, GameStateData cgs)");
        sb.AppendLine("        {");
        sb.AppendLine("            // Every detector assigns its own GameEventBool each tick.");
        foreach (var e in events)
            sb.AppendLine("            Detect" + e.Name + "(pgs, cgs);");
        sb.AppendLine("        }");
        sb.AppendLine();
        sb.AppendLine("        private void ResetEventBools()");
        sb.AppendLine("        {");
        foreach (var e in events)
            sb.AppendLine("            GameEventBool." + e.Name + " = false;");
        sb.AppendLine("        }");
        sb.AppendLine();
        foreach (var e in events.Where(x => x.Property.Length > 0))
        {
            sb.AppendLine("        private void Detect" + e.Name + "(GameStateData pgs, GameStateData cgs)");
            sb.AppendLine("        {");
            sb.AppendLine("            GameEventBool." + e.Name + " = " + Expression(e) + ";");
            sb.AppendLine("            if (GameEventBool." + e.Name + ")");
            sb.AppendLine("            {");
            sb.AppendLine("                EventBus.Publish(GameEvent." + e.Name + ", cgs);");
            sb.AppendLine("            }");
            sb.AppendLine("        }");
            sb.AppendLine();
        }
        sb.AppendLine("    }");
        sb.AppendLine("}");
        return LF(sb.ToString());
    }

    static void UpdateCustom(string path, List<EventRow> events)
    {
        string custom;
        if (File.Exists(path))
        {
            custom = LF(File.ReadAllText(path));
            if (!custom.Contains(Marker))
                throw new InvalidDataException(Path.GetFileName(path) + " missing insertion marker; refusing to modify handwritten code");
        }
        else
        {
            custom = "using CrewChiefV4.GameState;\n" +
                "namespace " + NamespaceName + "\n{\n" +
                "    public partial class GameStateEventDetector\n    {\n" +
                CustomComment + "\n\n" + Marker + "\n    }\n}\n";
        }
        if (!custom.Contains(CustomComment))
            custom = custom.Replace(Marker, CustomComment + "\n\n" + Marker);

        var declarations = new HashSet<string>(
            Regex.Matches(custom, @"\b(?:private|internal|protected|public)\s+void\s+Detect([A-Za-z_][A-Za-z_0-9]*)\s*\(")
                .Cast<Match>().Select(m => m.Groups[1].Value));
        var additions = new StringBuilder();
        foreach (var e in events.Where(x => x.Property.Length == 0 && !declarations.Contains(x.Name)))
        {
            additions.AppendLine("        private void Detect" + e.Name + "(GameStateData pgs, GameStateData cgs)");
            additions.AppendLine("        {");
            additions.AppendLine("#error Implement Detect" + e.Name);
            additions.AppendLine("            // EventBus.Publish(GameEvent." + e.Name + ", cgs);");
            additions.AppendLine("        }");
            additions.AppendLine();
        }
        if (additions.Length > 0)
            custom = custom.Replace(Marker, LF(additions.ToString()) + Marker);
        WriteIfChanged(path, custom);
    }
#>